# =============================================================
# Root environment consumed by docker-compose.yml
# Copy to .env and adjust. Values here target the CONTAINER network.
# For host-run development see server/.env.example instead.
# =============================================================

NODE_ENV=production

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app-password
DATABASE_URL=mysql://app:change-me-app-password@mysql:3306/app

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Meilisearch ---
MEILI_ENABLED=true
MEILI_HOST=http://meili:7700
MEILI_MASTER_KEY=change-me-meili-master-key-min-16-chars
MEILI_API_KEY=change-me-meili-master-key-min-16-chars

# --- API / URLs ---
PORT=5000
APP_URL=http://localhost
API_URL=http://localhost/api
CLIENT_URL=http://localhost
CORS_ORIGIN=http://localhost

# --- Auth secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-value-for-access-tokens
JWT_REFRESH_SECRET=replace-with-64-char-random-hex-value-for-refresh-tokens
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
MFA_TOKEN_SECRET=replace-with-64-char-random-hex-value-for-mfa-tokens

# --- Workers ---
WORKER_MODE=standalone

# --- Email (log | smtp | resend | sendgrid | mailgun | ses) ---
MAIL_DRIVER=log
MAIL_FROM="Acme <no-reply@example.com>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Storage (local | gcs) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase (FCM push) ---
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Security ---
PROD_CSP=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin
APP_PORT=80

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
